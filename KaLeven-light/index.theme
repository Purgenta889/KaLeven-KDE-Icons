[Icon Theme]
Name=KaLeven Light
Comment=Refresh of Breeze Icons
Inherits=breeze,gnome,hicolor

Example=x-directory-normal

FollowsColorScheme=true

Directories=24x24/places,24x24/status,24x24/devices,24x24/actions,24x24/categories,24x24/preferences,64x64/actions,64x64/apps,64x64/places,64x64/devices,64x64/mimetypes

[24x24/places]
Context=Places
Size=24
MinSize=8
MaxSize=48
Type=Scalable

[24x24/status]
Context=Status
Size=24
MinSize=8
MaxSize=48
Type=Scalable

[24x24/devices]
Context=Devices
Size=24
MinSize=8
MaxSize=48
Type=Scalable

[24x24/actions]
