MinSize=8
MaxSize=48
Type=Scalable

[24x24/categories]
Context=Categories
Size=24
MinSize=8
MaxSize=48
Type=Scalable

[24x24/preferences]
Context=Applications
Size=24
MinSize=8
MaxSize=48
Type=Scalable

[64x64/actions]
